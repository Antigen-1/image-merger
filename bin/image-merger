#!/bin/sh
# image-merger — stitch images according to an s-exp config, running the
# project's own boot program (custom scheme-start, see im-main.ss) on top of
# the installed chez-python boot.
#
# Requires the cached boot: run `make build` first (or `make run CFG=...`).
set -eu

ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
BOOT=${IMAGE_MERGER_BOOT:-"$ROOT/.build/image-merger.boot"}

if [ ! -f "$BOOT" ]; then
    echo "image-merger: boot file not found: $BOOT" >&2
    echo "run 'make build' first, or use 'make run CFG=<config-file>'" >&2
    exit 2
fi

case "${1:-}" in
  -h|--help)
    exec scheme -q -b "$BOOT" -- --help
    ;;
  "")
    echo "usage: image-merger <config-file>" >&2
    exit 2
    ;;
esac

if [ "$#" -ne 1 ]; then
    echo "usage: image-merger <config-file>" >&2
    exit 2
fi

# Resolve the config path to an absolute path so relative image paths in the
# config are resolved against the config's own directory.
CONFIG=$(CDPATH='' cd -- "$(dirname -- "$1")" && pwd)/$(basename "$1")

# Inject the Python module search path.  The boot itself is layout-agnostic:
# the venv's site-packages is derived from the venv's own python (sysconfig
# handles lib vs lib64 and any venv layout) and handed to the embedded
# interpreter via PYTHONPATH, which Py_Initialize honours.
if [ ! -x "$ROOT/.venv/bin/python" ]; then
    echo "image-merger: venv not found ($ROOT/.venv); run 'make venv' first" >&2
    exit 2
fi
VENV_SITE=$("$ROOT/.venv/bin/python" -c 'import sysconfig; print(sysconfig.get_path("purelib"))')
PYTHONPATH_ARG="--pythonpath"
PYTHONPATH_VALUE="$VENV_SITE:$ROOT/python"

# chez-python embeds the Python interpreter by dlopen'ing libpython3 with local
# symbol visibility, so Python's C-extension stdlib modules (math, _struct,
# ... and Pillow's _imaging) cannot resolve the CPython API and fail with
# "undefined symbol: PyFloat_Type".  LD_PRELOAD loads libpython3 with global
# scope (RTLD_GLOBAL) before chez-python starts, which fixes that.
case ":${LD_PRELOAD:-}:" in
  *:libpython3*:*|*/libpython3*) ;;
  *)
    LIBPYTHON=$(ldconfig -p 2>/dev/null | awk '/^[[:space:]]*libpython3\.so /{print $NF; exit}')
    [ -n "$LIBPYTHON" ] || LIBPYTHON=libpython3.so
    export LD_PRELOAD="$LIBPYTHON${LD_PRELOAD:+:$LD_PRELOAD}"
    ;;
esac

exec scheme -q -b "$BOOT" -- "$PYTHONPATH_ARG" "$PYTHONPATH_VALUE" "$CONFIG"
